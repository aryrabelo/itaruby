#!/usr/bin/env python3
"""Close a change: run every gate, write the closing report, seal it, ask Jev.

Run: ops exec typesafe-api-key -- scripts/closing-evidence   (clean tree, at the commit being closed)

Why this exists (AGENTS.md, closing gate): "the gates passed" was a sentence in
a hand-off, and a sentence is what the software factory refuses to trust. This
turns it into the `closing` gate's evidence:

  1. `./scripts/dev gates` runs on the committed tree, in the gate box (it
     never builds here). Nothing is reused from an earlier run: the box's
     HEAD must be the commit being closed and its digest must be newer than
     this run's start, or it is not evidence about this commit.
  2. The box's `target/gauntlet/digest.json` becomes `.software-factory/evidence/
     closing-run.json`, with every private-corpus revision removed (the report
     is committed AND sent to the judge; the secrecy wall covers both).
     corpus-c is required only where it is mounted (mapped AND on disk);
     elsewhere the report says so, and the public corpora carry the proof:
     every baselined public repo must be measured with zero new and zero
     gone errors. gitlab-foss has no baseline and is the only allowed skip.
  3. The evidence manifest (`.software-factory/evidence/closing.json`) is
     seeded with this one run and `sf seal closing` recomputes its digests
     from what is actually on disk, binding the report to the
     implementation digest so the next change to the checker expires it
     (L3.GATE_HAS_FRESH_EVIDENCE).
  4. The marked closing claim and the report, verbatim, become Jev's question
     (`.software-factory/evidence/jev/closing.json`) and its negated twin; `scripts/claim-judge-gate`
     asks both and caches the verdicts (L4.CLAIM_IS_SUPPORTED_BY_ITS_EVIDENCE).

Exit: 0 closed · 1 a gate or the judge said no (the report is still written,
unsealed, so the reason is readable) · 2 could not run.
"""
import json
import os
import re
import subprocess
import sys
from pathlib import Path
import time


ROOT = Path(__file__).resolve().parent.parent
BOX = Path(os.environ.get("ITA_GATE_BOX") or Path.home() / ".cache/itaruby/gate-box").expanduser()
ART = BOX / "target/gauntlet"
CORPORA_MAP = ROOT / "scripts/corpora-local.txt"
BASELINED = sorted(p.stem for p in (ROOT / "scripts/public-baseline").glob("*.jsonl"))
REPORT = ROOT / ".software-factory/evidence/closing-run.json"
MANIFEST = ROOT / ".software-factory/evidence/closing.json"
POLICY = ROOT / ".software-factory/policy.yaml"
REQUEST = ROOT / ".software-factory/evidence/jev/closing.json"
TWIN = ROOT / ".software-factory/evidence/jev/closing.twin.json"
CLAIM_DOC = ROOT / "AGENTS.md"
CLAIM_ID = "CLOSING_GATES_GREEN"
# Paths this script itself writes; everything else must be committed first.
OWN = {
    ".software-factory/evidence/closing.json",
    ".software-factory/evidence/closing-run.json",
    ".software-factory/evidence/jev/closing.json",
    ".software-factory/evidence/jev/closing.twin.json",
    ".software-factory/evidence/jev/closing.cache.json",
}
GOAL = (
    "Close this change the way the repository's owner closes one: run every gate "
    "this machine can run against the committed tree, and show that nothing the "
    "checker says about real code got worse."
)
QUESTION = {
    "relation": {
        "type": "choice",
        "instructions": (
            "`claim` is a sentence the repository makes about the commit it closes. "
            "`evidence` is the gate report produced by running the gates on that commit. "
            "Does the evidence support the claim? Judge only what the evidence shows."
        ),
        "criteria": {
            "supports": "the evidence contains every effect the claim promises",
            "contradicts": "the evidence shows at least one of the promised effects did not happen",
            "says_nothing": "the evidence is silent about at least one effect the claim promises",
        },
    }
}


def git(*args):
    return subprocess.run(["git", *args], cwd=ROOT, text=True, capture_output=True, check=True).stdout


def claim_sentence():
    """The sentence right after the marker, so the doc and the question cannot drift."""
    lines = CLAIM_DOC.read_text().splitlines()
    marker = re.compile(rf"<!--\s*claim:\s*{CLAIM_ID}\s+proven-by:\s*closing\s*-->")
    hits = [i for i, line in enumerate(lines) if marker.search(line)]
    if len(hits) != 1:
        raise SystemExit(f"closing-evidence: expected one `{CLAIM_ID}` marker in AGENTS.md, found {len(hits)}")
    rest = [line.strip() for line in lines[hits[0] + 1:]]
    sentence = []
    for line in rest:
        if not line:
            if sentence:
                break
            continue
        sentence.append(line)
    return " ".join(sentence)


def redact(digest):
    """Private-corpus revisions and error-set hashes never leave this machine."""
    for gate in digest.get("gates", []):
        for corpus in gate.get("numbers", {}).get("corpora", []) if isinstance(gate.get("numbers"), dict) else []:
            for key in ("rev", "pinned", "error_set_sha"):
                corpus.pop(key, None)
        if isinstance(gate.get("reason"), str):
            gate["reason"] = re.sub(r"\[rev [^\]]*\]", "[rev withheld]", gate["reason"])
    digest.pop("machine", None)
    return digest


def gate(digest, name):
    return next((g for g in digest.get("gates", []) if g.get("name") == name), {})


def corpus_c_mounted():
    """Mapped in this machine's corpora map AND present on disk."""
    try:
        lines = CORPORA_MAP.read_text().splitlines()
    except OSError:
        return False
    paths = [line.split(None, 1)[1].strip() for line in lines
             if line.split(None, 1)[:1] == ["corpus-c"] and len(line.split(None, 1)) == 2]
    return bool(paths) and Path(paths[0]).is_dir()


def public_corpora_clean():
    """Every baselined repo's own verdict line in the artifact, not the
    digest's transcript-derived summary: gate-digest only ever sees the
    one-line `ok`/`skip` `gauntlet-gates.sh` logs for gate f, never the
    per-repo detail `public-gate.sh` writes straight to `public.txt` — so a
    structured read of the digest can never see individual repos (measured
    2026-10-21: `numbers.repos` is always `[]`). Read the artifact itself.
    A repo is clean only if its own exact-match line is present; a drifted
    or skipped-for-cause line, or no line at all, fails it.
    """
    try:
        lines = (ART / "public.txt").read_text().splitlines()
    except OSError:
        return False
    clean = {m.group(1) for line in lines
             if (m := re.search(r"^PASS public errors match baseline exactly \((\w[\w-]*)\):", line))}
    return bool(BASELINED) and all(rid in clean for rid in BASELINED)


def assertions(exit_code, digest, box_head, head, fresh, src_clean, mounted, public_ok):
    corpus_c = next(
        (c for c in gate(digest, "d").get("numbers", {}).get("corpora", []) if c.get("id") == "corpus-c"),
        None,
    )
    c1 = gate(digest, "c1").get("numbers", {})
    # A SKIP is allowed only where its reason is one of the two declared
    # absences; every other gate must PASS.
    allowed_skip = {"f"} | ({"d"} if not mounted else set())
    others_green = all(
        g.get("status") == "PASS" or (g.get("status") == "SKIP" and g.get("name") in allowed_skip)
        for g in digest.get("gates", [])
    )
    corpus_c_proved = (corpus_c is not None and corpus_c.get("new") == 0
                       and "corpus-c" in digest.get("corpus", {}).get("proved", []))
    # The seven names are the policy's `required_assertions` and never change.
    # Where corpus-c is not mounted, its two assertions say so in `basis` and
    # pass only if the gate really skipped it AND the public corpora proved
    # clean; the report never claims a corpus-c measurement that did not run.
    absent_ok = gate(digest, "d").get("status") == "SKIP" and public_ok
    corpus_basis = "measured" if mounted else "not_mounted_here; public corpora carry the proof"
    checks = {
        "dev_gates.exit_zero": (exit_code in (0, 2) and others_green and bool(digest.get("gates"))
                                and box_head == head and fresh, "gate box at the closing commit, fresh digest"),
        "corpus.proved_corpus_c": (corpus_c_proved if mounted else absent_ok, corpus_basis),
        "corpus_c.no_new_errors": (corpus_c_proved if mounted else absent_ok, corpus_basis),
        "public_corpora.no_drift": (public_ok, "zero new and zero gone: " + ", ".join(BASELINED)),
        "mutants.every_decision_accused": (gate(digest, "c1").get("status") == "PASS"
                                           and c1.get("not_accused") == 0 and c1.get("total", 0) > 0, None),
        # The negative path: the drift detectors themselves are proven to fire
        # on planted drift, so "no drift" above is a measurement, not silence.
        "instruments.drift_detectors_fire": (gate(digest, "c2b").get("status") == "PASS", None),
        "source.untouched_after_mutants": (src_clean, "gate box crates/ equal to HEAD"),
    }
    results = []
    for kind, (ok, basis) in checks.items():
        results.append({"type": kind, "status": "passed" if ok else "failed", **({"basis": basis} if basis else {})})
    return results


def seed_manifest(head):
    """`sf seal closing` only RECOMPUTES digests in an existing manifest
    (`Manifest::load` must succeed first); nothing else in this repository
    ever creates the initial one. Seed it with the one run this script just
    produced, required_assertions read straight from policy so the two
    never drift, and empty digests — `sf seal` fills those in from what is
    actually on disk.
    """
    import yaml
    policy = yaml.safe_load(POLICY.read_text())
    required = policy["gates"]["closing"]["required_assertions"]
    manifest = {
        "schema_version": 1,
        "gate": "closing",
        "implementation_sha256": "",
        "runs": [{
            "scenario": "closing",
            "status": "passed",
            "actor": f"scripts/closing-evidence, gauntlet run in the gate box at {head[:10]}",
            "report": str(REPORT.relative_to(ROOT)),
            "report_sha256": "",
            "required_assertions": required,
        }],
    }
    write_json(MANIFEST, manifest)


def request(claim, evidence, criteria):
    question = json.loads(json.dumps(QUESTION))
    question["relation"]["criteria"] = criteria
    return {"model": "jev-latest", "state": {"claim": claim, "evidence": evidence}, "questions": question}


def write_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, indent=2, ensure_ascii=False) + "\n")


def main():
    dirty = [line[3:] for line in git("status", "--porcelain", "--untracked-files=all").splitlines()
             if line[3:] not in OWN]
    if dirty:
        print("closing-evidence: commit first; evidence certifies committed code only:", *dirty, sep="\n  ")
        return 2
    claim = claim_sentence()
    head = git("rev-parse", "HEAD").strip()

    started = time.time()
    gates = subprocess.run(["./scripts/dev", "gates"], cwd=ROOT, check=False)
    try:
        digest_path = ART / "digest.json"
        digest = json.loads(digest_path.read_text())
        fresh = digest_path.stat().st_mtime >= started
    except (OSError, ValueError) as error:
        print(f"closing-evidence: no gate digest to read at {ART}: {error}")
        return 2
    box_git = ["git", "-C", str(BOX)]
    box_head = subprocess.run([*box_git, "rev-parse", "HEAD"], text=True, capture_output=True,
                              check=False).stdout.strip()
    # The mutants rewrite the box, never this tree, so the box is what must be clean.
    src_clean = subprocess.run([*box_git, "diff", "--quiet", "HEAD", "--", "crates"]).returncode == 0

    mounted = corpus_c_mounted()
    public_ok = public_corpora_clean()
    results = assertions(gates.returncode, redact(digest), box_head, head, fresh, src_clean, mounted, public_ok)
    passed = all(a["status"] == "passed" for a in results)
    sf = subprocess.run(["sf", "--version"], text=True, capture_output=True, check=False).stdout.strip()
    report = {
        "scenario": "closing",
        "status": "passed" if passed else "failed",
        "goal": GOAL,
        "commit": head,
        "sf": sf,
        "corpus_c": {
            "rule": "corpus.proved_corpus_c and corpus_c.no_new_errors pass either by "
                    "measuring corpus-c directly with zero new errors, or, when corpus-c "
                    "is not mounted on this machine, by every baselined public corpus "
                    "matching its own baseline exactly: zero new and zero gone diagnostics.",
            "mounted_here": mounted,
            "public_corpora_matched_baseline": public_ok,
        },
        "observed": digest,
        "assertions": results,
    }
    write_json(REPORT, report)
    for a in results:
        print(f"{a['status'].upper():7} {a['type']}")
    if not passed:
        print("closing-evidence: NOT closed; report written unsealed at", REPORT.relative_to(ROOT))
        return 1

    evidence = REPORT.read_text()
    real = QUESTION["relation"]["criteria"]
    # The twin swaps what `supports` and `says_nothing` mean: same claim, same
    # evidence, the definition of passing turned upside down. A judge that
    # approves both is approving anything.
    twin = dict(real, supports=real["says_nothing"], says_nothing=real["supports"])
    write_json(REQUEST, request(claim, evidence, real))
    write_json(TWIN, request(claim, evidence, twin))
    seed_manifest(head)
    if subprocess.run(["sf", "seal", "closing"], cwd=ROOT, check=False).returncode != 0:
        print("closing-evidence: sf seal closing failed")
        return 2
    # The verdict comes from TypeSafe's own endpoint, never a local proxy: a
    # machine-wide TYPESAFE_BASE_URL (this fleet points it at an OpenRouter
    # shim for other tools) is dropped so the judge uses its default,
    # https://api.typesafe.ai. Run under `ops exec typesafe-api-key --`.
    if not os.environ.get("TYPESAFE_API_KEY"):
        print("closing-evidence: TYPESAFE_API_KEY is not set — run: ops exec typesafe-api-key -- scripts/closing-evidence")
        return 2
    judge_env = {k: v for k, v in os.environ.items() if k != "TYPESAFE_BASE_URL"}
    judged = subprocess.run([sys.executable, "scripts/claim-judge-gate", "--expect", "relation=supports",
                             "--min-confidence", "0.8"], cwd=ROOT, env=judge_env, check=False)
    if judged.returncode != 0:
        print("closing-evidence: Jev did not accept the claim against this evidence")
        return judged.returncode
    print(f"closed {head[:10]}: commit .software-factory/evidence/closing*.json and .software-factory/evidence/jev/closing*.json")
    return 0


if __name__ == "__main__":
    sys.exit(main())
