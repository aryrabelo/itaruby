#!/usr/bin/env bash
# Single entry point for a human or an agent on a clean machine: prepare it,
# then run the gates. `gates` runs in ONE persistent, serialized linked
# worktree under `~/.cache` (the gate box), so the checkout an agent is
# editing is never rewritten by an in-place mutant.
#
# Every worktree that ran gates grew its own target (about 150 GiB across the
# itaruby worktrees on 2026-09-29). One gate box keeps one persistent target
# and serializes runs, which the perf gate needs anyway: a loaded machine is
# not a measurement. A killed run is healed by the next forced checkout.
# The box is a reproducible cache under ~/.cache (omp-safe sessions may write
# there) and is safe to delete.
#
#   setup   idempotent machine prep + prints which gates this machine can run
#   gates   mirror this tree into the gate box, then run the gates
#   anchor  runs the gates on the corpora machine (work) over ssh
#   prove   local gates + anchor, and demands their union cover every corpus
#
# Corpus paths are machine-local and never versioned: scripts/corpora-local.txt
# (gitignored) maps each generic id from scripts/corpus-baseline.txt to a real
# path on this machine, one `<id> <path>` line per corpus — `<path>` is either
# absolute, or relative to $CORPORA_ROOT (default $HOME/Sites). The `anchor`
# verb ssh's to $WORK_HOST and runs scripts/gauntlet-gates.sh there, which
# reads that machine's OWN scripts/corpora-local.txt — the mapping never
# travels over ssh.
#
# ponytail: bash with subcommands, not `cargo xtask`/cargo-make/a Makefile.
# xtask is the right idiom when contributors are cross-platform and shouldn't
# have to install anything — here it would be a new crate that only shells
# out to the bash script that already exists and works, for a fleet of two
# Macs. Upgrade trigger: the first non-Unix contributor, or a Windows CI
# runner. Until then this is the lazier and equally correct choice.
set -uo pipefail

# The locked re-entry must run THIS file, whatever it is called: resolve it
# before the cd below makes a relative $0 meaningless.
SELF=$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")
cd "$(dirname "$0")/.."
ROOT=$PWD
CORPORA_ROOT=${CORPORA_ROOT:-$HOME/Sites}
CORPORA_MAP=$ROOT/scripts/corpora-local.txt
WORK_HOST=${WORK_HOST:-work}

usage() {
  cat >&2 <<EOF
usage: scripts/dev <setup|gates|anchor|prove> [options]

  setup   prepare this machine (idempotent), report which gates it can run
  gates   mirror into the serialized gate box, then run a script
          --at <rev>      run exactly a committed revision, without overlay
          --run <path>    run this repo-relative script (default: scripts/gauntlet-gates.sh)
          --wait          wait for a busy gate box instead of exiting 75
          --              forward all following arguments to the script
  anchor  run the gates on \$WORK_HOST (default: work) over ssh
  prove   gates + anchor; exit 0 only if every declared corpus was proved
EOF
}

say() { printf '\n=== %s\n' "$1"; }

# git subprocesses must not inherit a linked worktree's ambient repository
# variables. In particular, a caller's GIT_INDEX_FILE would make the mirror
# proof inspect the wrong index.
git_clean() {
  env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u GIT_PREFIX \
    -u GIT_COMMON_DIR -u GIT_AUTHOR_DATE -u GIT_COMMITTER_DATE git "$@"
}
git_index() {
  local index=$1
  shift
  env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u GIT_PREFIX \
    -u GIT_COMMON_DIR -u GIT_AUTHOR_DATE -u GIT_COMMITTER_DATE \
    GIT_INDEX_FILE="$index" git "$@"
}


copy_corpora_map() {
  local source=$1 box=$2 common=$3 source_map main_map box_map
  source_map=$source/scripts/corpora-local.txt
  main_map="$(dirname "$common")/scripts/corpora-local.txt"
  box_map=$box/scripts/corpora-local.txt
  if [[ -f $source_map ]]; then
    cp "$source_map" "$box_map" || return 65
    cmp -s "$source_map" "$box_map" || {
      echo 'gate box corpus map does not match source' >&2
      return 65
    }
  elif [[ -f $main_map ]]; then
    cp "$main_map" "$box_map" || return 65
    cmp -s "$main_map" "$box_map" || {
      echo 'gate box corpus map does not match main checkout' >&2
      return 65
    }
  else
    rm -f "$box_map"
  fi
}

copy_untracked() {
  local source=$1 box=$2 count
  # Check the complete byte budget before handing paths to tar. This is
  # deliberately a second git ls-files call: retaining NUL-delimited paths in
  # a shell variable would corrupt names containing whitespace or newlines.
  if ! git_clean -C "$source" ls-files -z --others --exclude-standard |
    python3 -c '
import os
import sys
root = sys.argv[1]
raw = sys.stdin.buffer.read()
paths = [p for p in raw.split(b"\0") if p]
total = 0
sizes = []
for encoded in paths:
    rel = os.fsdecode(encoded)
    try:
        size = os.lstat(os.path.join(root, rel)).st_size
    except FileNotFoundError:
        size = 0
    total += size
    sizes.append((size, rel))
limit = 50 * 1024 * 1024
if total > limit:
    print(f"gate box refuses {total} bytes of untracked files (limit {limit})",
          file=sys.stderr)
    for size, rel in sorted(sizes, reverse=True)[:10]:
        print(f"  {size:>12} {rel}", file=sys.stderr)
    raise SystemExit(65)
' "$source"
  then
    return 65
  fi
  count=$(git_clean -C "$source" ls-files -z --others --exclude-standard |
    python3 -c 'import sys; print(sum(1 for p in sys.stdin.buffer.read().split(b"\0") if p))') ||
    return 65
  if (( count )); then
    git_clean -C "$source" ls-files -z --others --exclude-standard |
      tar -C "$source" --null -T - -cf - |
      tar -C "$box" -xf - || return 65
  fi
}

tree_for() {
  local tree=$1 index=$2
  git_index "$index" -C "$tree" read-tree HEAD &&
    git_index "$index" -C "$tree" add -A &&
    git_index "$index" -C "$tree" write-tree
}

run_gate_box() {
  local source=$1 box=$2 at_rev=$3 run_script=$4
  shift 4
  local common source_head target_sha box_head source_tree box_tree expected_tree
  local source_actual_tree delta artifacts status
  # These are globals because the EXIT trap runs after this function's locals
  # have gone out of scope.
  common=$(git_clean -C "$source" rev-parse --path-format=absolute --git-common-dir) ||
    return 65
  source=$(cd "$source" && pwd -P)
  box=$(cd "$box" 2>/dev/null && pwd -P || printf '%s' "$box")
  source_head=$(git_clean -C "$source" rev-parse HEAD) || return 65
  if [[ -n $at_rev ]]; then
    target_sha=$(git_clean -C "$source" rev-parse "$at_rev^{commit}") || {
      echo "gate box cannot resolve --at $at_rev" >&2
      return 65
    }
  else
    target_sha=$source_head
  fi

  case $run_script in
    /* | ../* | */../* | ..)
      echo "gate box --run must be a repo-relative path: $run_script" >&2
      return 64
      ;;
  esac
  run_script=${run_script#./}

  if [[ $source == "$box" ]]; then
    [[ -f $box/$run_script ]] || {
      echo "gate box script not found: $run_script" >&2
      return 65
    }
    printf 'gate box: %s — direct (locked) @ %s\n' "$box" "${target_sha:0:7}"
    (
      cd "$box" || exit 65
      # The lock helper's own state must not reach the script: a nested
      # `scripts/dev gates` (the gate-box selftest, run by gate c2b inside
      # this very box) would otherwise skip its lock and read OUR source.
      unset ITA_GATE_BOX ITA_GATE_BOX_LOCKED ITA_GATE_BOX_SOURCE \
        ITA_GATE_BOX_TARGET_SHA ITA_GATE_BOX_COMMON ITA_GATE_BOX_WAIT
      env -u CARGO_TARGET_DIR -u CARGO_BUILD_TARGET_DIR -u ART -u TRANSCRIPT \
        "./$run_script" "$@"
    )
    status=$?
    artifacts=$box/target/gauntlet
    printf 'gate box artifacts: %s\n' "$artifacts"
    printf 'gate box triage: scripts/gate-triage --digest %s/digest.json\n' "$artifacts"
    return "$status"
  fi

  if [[ -e $box ]]; then
    local box_common
    box_common=$(git_clean -C "$box" rev-parse --path-format=absolute --git-common-dir) ||
      { echo "gate box exists but is not a worktree: $box" >&2; return 65; }
    if [[ $box_common != "$common" ]]; then
      echo "gate box belongs to another repository: $box" >&2
      return 65
    fi
  else
    git_clean -C "$source" worktree prune || return 65
    mkdir -p "$(dirname "$box")" || return 65
    git_clean -C "$source" worktree add --detach --force "$box" "$target_sha" ||
      return 65
  fi

  git_clean -C "$box" checkout --detach --force "$target_sha" || return 65
  git_clean -C "$box" clean -fd || return 65
  if [[ -z $at_rev ]]; then
    # GATE_BOX_TRACKED_OVERLAY
    if ! git_clean -C "$source" diff --quiet --binary HEAD; then
      git_clean -C "$source" diff --binary HEAD |
        git_clean -C "$box" apply || return 65
    fi
    copy_untracked "$source" "$box" || return 65
  fi
  # GATE_BOX_CORPORA_MAP
  copy_corpora_map "$source" "$box" "$common" || return 65

  GATE_BOX_SOURCE_INDEX=$common/ita-gate-box-source-index.$$.${RANDOM}
  GATE_BOX_BOX_INDEX=$common/ita-gate-box-box-index.$$.${RANDOM}
  trap 'rm -f "${GATE_BOX_SOURCE_INDEX:-}" "${GATE_BOX_BOX_INDEX:-}"' EXIT
  source_actual_tree=$(tree_for "$source" "$GATE_BOX_SOURCE_INDEX") || return 65
  box_tree=$(tree_for "$box" "$GATE_BOX_BOX_INDEX") || return 65
  box_head=$(git_clean -C "$box" rev-parse HEAD) || return 65
  # GATE_BOX_VERIFY_MIRROR
  if [[ -n $at_rev ]]; then
    expected_tree=$(git_clean -C "$source" rev-parse "$target_sha^{tree}") || return 65
    source_tree=$expected_tree
    if [[ $box_tree != "$expected_tree" || $box_head != "$target_sha" ]]; then
      echo "gate box does not mirror $source: tree $source_tree != $box_tree" >&2
      return 65
    fi
  else
    source_tree=$source_actual_tree
    if [[ $source_tree != "$box_tree" || $source_head != "$box_head" ]]; then
      echo "gate box does not mirror $source: tree $source_tree != $box_tree" >&2
      return 65
    fi
  fi
  expected_tree=${expected_tree:-$source_tree}
  # The label describes what the BOX holds: an `--at` run never carries the
  # source's uncommitted delta, whatever state the source tree is in.
  if [[ -z $at_rev && $source_actual_tree != "$(git_clean -C "$source" rev-parse HEAD^{tree})" ]]; then
    delta='+ uncommitted delta'
  else
    delta='clean'
  fi
  if [[ $delta == clean ]]; then
    printf 'gate box: %s — %s @ %s (clean)\n' \
      "$box" "$source" "${target_sha:0:7}"
  else
    printf 'gate box: %s — %s @ %s (+ uncommitted delta, tree %s)\n' \
      "$box" "$source" "${target_sha:0:7}" "${expected_tree:0:7}"
  fi
  [[ -f $box/$run_script ]] || {
    echo "gate box script not found after mirroring: $run_script" >&2
    return 65
  }
  (
    cd "$box" || exit 65
    # GATE_BOX_INTERNAL_SCRUB — see the direct branch above.
    unset ITA_GATE_BOX ITA_GATE_BOX_LOCKED ITA_GATE_BOX_SOURCE \
      ITA_GATE_BOX_TARGET_SHA ITA_GATE_BOX_COMMON ITA_GATE_BOX_WAIT
    # GATE_BOX_ENV_CLEAN
    env -u CARGO_TARGET_DIR -u CARGO_BUILD_TARGET_DIR -u ART -u TRANSCRIPT \
      "./$run_script" "$@"
  )
  status=$?
  artifacts=$box/target/gauntlet
  printf 'gate box artifacts: %s\n' "$artifacts"
  printf 'gate box triage: scripts/gate-triage --digest %s/digest.json\n' "$artifacts"
  return "$status"
}

acquire_gate_box_lock() {
  python3 - "$@" <<'PY'
import fcntl
import os
import sys
import time

source, box, sha, script = sys.argv[1:5]
args = sys.argv[5:]
common = os.environ["ITA_GATE_BOX_COMMON"]
wait = os.environ.pop("ITA_GATE_BOX_WAIT", "0") == "1"
fd = os.open(os.path.join(common, "ita-gate-box.lock"), os.O_RDWR | os.O_CREAT, 0o600)
try:
    fcntl.flock(fd, fcntl.LOCK_EX | (0 if wait else fcntl.LOCK_NB))
except BlockingIOError:
    with os.fdopen(os.dup(fd), "r", encoding="utf-8", errors="replace") as holder:
        line = holder.readline().strip() or "unknown holder"
    print(f"gate box busy: {line}", file=sys.stderr)
    os.close(fd)
    raise SystemExit(75)
os.ftruncate(fd, 0)
os.write(fd, f"pid={os.getpid()} since={time.strftime('%Y-%m-%dT%H:%M:%S%z')} "
             f"src={source} rev={sha}\n".encode())
os.set_inheritable(fd, True)
env = os.environ.copy()
env["ITA_GATE_BOX_LOCKED"] = "1"
env["ITA_GATE_BOX"] = box
env["ITA_GATE_BOX_SOURCE"] = source
env["ITA_GATE_BOX_TARGET_SHA"] = sha
os.execvpe("bash", ["bash", script, "gates", *args], env)
PY
}
cmd_setup() {
  say 'git hooks'
  git config core.hooksPath .githooks
  echo "core.hooksPath -> .githooks"

  if ! command -v cargo >/dev/null; then
    echo 'FAIL: cargo not found — install Rust (https://rustup.rs)' >&2
    exit 1
  fi

  say 'cargo build --release'
  cargo build --release || exit 1

  say 'sf (software-factory)'
  if command -v sf >/dev/null; then
    echo 'sf already installed'
  else
    echo 'installing sf...'
    cargo install --git https://github.com/nicolasmelo1/software-factory --locked || exit 1
  fi

  say 'bd (beads)'
  if ! command -v bd >/dev/null; then
    echo 'FAIL: bd not found — install with:' >&2
    echo '  curl -sSL https://raw.githubusercontent.com/steveyegge/beads/main/scripts/install.sh | bash' >&2
    exit 1
  fi
  if [[ -d $ROOT/.beads/embeddeddolt ]]; then
    echo 'beads DB already initialized'
  else
    echo 'initializing beads DB...'
    bd init --reinit-local --prefix ita --skip-agents && bd import .beads/issues.jsonl || exit 1
  fi

  say 'gates available on this machine'
  echo 'sf check, cargo test --workspace, mutation probes: always (no corpora needed)'
  declared=$(sed -n 's/^corpus \([^ ]*\).*/\1/p' scripts/corpus-baseline.txt)
  found=()
  missing=()
  for id in $declared; do
    path=""
    if [[ -f $CORPORA_MAP ]]; then
      path=$(awk -v id="$id" '$1 == id { print $2; exit }' "$CORPORA_MAP")
    fi
    if [[ -z $path ]]; then
      missing+=("$id (no mapping in scripts/corpora-local.txt)")
      continue
    fi
    case $path in
      /*) root=$path ;;
      *)  root="$CORPORA_ROOT/$path" ;;
    esac
    if [[ -d $root ]]; then
      found+=("$id")
    else
      missing+=("$id (mapped to $root, not found)")
    fi
  done
  if (( ${#found[@]} )); then
    echo "corpus diff + warning ceilings: yes for ${found[*]}"
  fi
  if (( ${#missing[@]} )); then
    echo "corpus diff + warning ceilings: NO for: ${missing[*]}"
    echo 'this machine cannot prove those corpora. the anchor run is the proof:'
    echo '  ./scripts/dev anchor'
  fi
}

cmd_gates() {
  local at_rev="" run_script="scripts/gauntlet-gates.sh" wait=0
  local source_root box common source_head target_sha
  local -a forwarded=() helper_args=()
  while (($#)); do
    case $1 in
      --at)
        (($# >= 2)) || { echo 'gates: --at requires a revision' >&2; return 64; }
        at_rev=$2; shift 2 ;;
      --run)
        (($# >= 2)) || { echo 'gates: --run requires a path' >&2; return 64; }
        run_script=$2; shift 2 ;;
      --wait) wait=1; shift ;;
      --)
        shift
        forwarded=("$@")
        break ;;
      *)
        echo "gates: unknown option: $1 (use -- to forward it)" >&2
        return 64 ;;
    esac
  done
  box=${ITA_GATE_BOX:-$HOME/.cache/itaruby/gate-box}
  [[ $box == /* ]] || box=$ROOT/$box
  source_root=${ITA_GATE_BOX_SOURCE:-$ROOT}

  # The lock helper execs this same script with an inheritable fd. Re-entry
  # therefore performs the mirror and the run while Python's flock remains
  # held, rather than taking a second lock.
  if [[ ${ITA_GATE_BOX_LOCKED:-0} == 1 ]]; then
    run_gate_box "$source_root" "$box" "$at_rev" "$run_script" \
      "${forwarded[@]}"
    return $?
  fi

  common=$(git_clean -C "$ROOT" rev-parse --path-format=absolute --git-common-dir) ||
    return 65
  source_head=$(git_clean -C "$ROOT" rev-parse HEAD) || return 65
  if [[ -n $at_rev ]]; then
    target_sha=$(git_clean -C "$ROOT" rev-parse "$at_rev^{commit}") || {
      echo "gate box cannot resolve --at $at_rev" >&2
      return 65
    }
  else
    target_sha=$source_head
  fi
  helper_args=("$ROOT" "$box" "$target_sha" "$SELF")
  [[ -n $at_rev ]] && helper_args+=(--at "$at_rev")
  [[ $run_script != scripts/gauntlet-gates.sh ]] &&
    helper_args+=(--run "$run_script")
  helper_args+=(--)
  helper_args+=("${forwarded[@]}")
  export ITA_GATE_BOX_COMMON=$common
  export ITA_GATE_BOX_WAIT=$wait
  # GATE_BOX_LOCK_ACQUIRE
  acquire_gate_box_lock "${helper_args[@]}"
}

# Captures the remote run so the union of proved corpora can be checked. Exit 2
# is legitimate here: no single machine holds every corpus, so "incomplete" is
# the normal remote answer. What is NOT legitimate is a remote run that proved
# nothing — that means the corpora machine lost its corpora, and the whole
# anchor is theatre.
cmd_anchor() {
  local branch sha out status
  branch=$(git rev-parse --abbrev-ref HEAD)
  sha=$(git rev-parse HEAD)
  if [[ -z $(git branch -r --contains "$sha" 2>/dev/null) ]]; then
    # The remote machine can only fetch what a remote already has; without this
    # the failure surfaces as a cryptic `git checkout` error over ssh.
    echo "commit ${sha:0:7} is not on any remote: push before anchoring" >&2
    exit 65
  fi
  say "anchor run on $WORK_HOST — $branch @ ${sha:0:7}"
  # Checking out the local HEAD there is the point: an anchor run against
  # whatever the remote machine happened to have checked out is a false green.
  #
  # The remote command mirrors AGENTS.md's anchor block exactly, because each
  # piece is a measured trap (2026-09-18/21): the checkout that holds the
  # corpora map is ~/Sites/personal-team/itaruby (~/Sites/itaruby has none and
  # SKIPs both corpora green); the run happens in a disposable worktree so
  # another agent's checkout never moves; the map is COPIED into it (a fresh
  # worktree has none); the sha is fetched from $ANCHOR_REMOTE, default
  # `origin` (the public repo IS the repository since 2026-09-22; before
  # that, `private`); PERF_COLUMN=ci because work has no measured
  # dev column and a copied ceiling is a fabricated measurement; ruby by
  # ABSOLUTE path, because `brew` itself is not on a non-interactive ssh
  # PATH — `$(brew --prefix ruby)` expands to nothing there and gate 0b
  # names /usr/bin/ruby 2.6 (measured 2026-09-21, one run wasted). The
  # artifacts are copied out BEFORE the worktree goes: a red anchor whose
  # evidence died with its tree is a verdict nobody can read.
  local wt="~/Sites/worktrees/ita-anchor-${sha:0:7}"
  local keep="~/Sites/temp-files/ita-anchor-${sha:0:7}-\$(date +%Y%m%d-%H%M%S)"
  out=$(ssh "$WORK_HOST" "cd ~/Sites/personal-team/itaruby \
    && git fetch -q ${ANCHOR_REMOTE:-origin} \
    && git worktree add -f --detach $wt $sha \
    && cp ~/Sites/personal-team/itaruby/scripts/corpora-local.txt $wt/scripts/corpora-local.txt \
    && cd $wt \
    && PERF_COLUMN=ci PATH=\"/opt/homebrew/opt/ruby/bin:\$HOME/.cargo/bin:\$PATH\" ./scripts/gauntlet-gates.sh; \
    s=\$?; keep=$keep; mkdir -p \$keep && cp -R $wt/target/gauntlet/. \$keep/ && echo \"anchor artifacts: \$keep\"; \
    cd ~/Sites/personal-team/itaruby && git worktree remove --force $wt; exit \$s" 2>&1)
  status=$?
  printf '%s\n' "$out"
  if [[ $status -ne 0 && $status -ne 2 ]]; then
    echo "anchor failed at ${sha:0:7}: exit $status" >&2
    exit "$status"
  fi
  ANCHOR_PROVED=$(printf '%s\n' "$out" | sed -n 's/^corpus gate proved: //p' | tail -1)
  if [[ -z ${ANCHOR_PROVED// /} ]]; then
    echo "anchor proved zero corpora on $WORK_HOST: did its corpora disappear?" >&2
    exit 1
  fi
}

# The only command that answers "is this commit actually proved?". Neither
# machine holds every corpus, so a single green run never means full coverage:
# this unions what each machine proved and demands it cover every corpus the
# baseline declares.
cmd_prove() {
  local declared local_proved union missing
  declared=$(sed -n 's/^corpus \([^ ]*\) .*/\1/p' scripts/corpus-baseline.txt | sort)
  local_out=$(cmd_gates 2>&1); local_status=$?
  printf '%s\n' "$local_out"
  if [[ $local_status -ne 0 && $local_status -ne 2 ]]; then
    echo "local gates failed: exit $local_status" >&2
    exit "$local_status"
  fi
  local_proved=$(printf '%s\n' "$local_out" | sed -n 's/^corpus gate proved: //p' | tail -1)
  cmd_anchor
  union=$(printf '%s %s' "$local_proved" "$ANCHOR_PROVED" | tr ' ' '\n' | sed '/^$/d' | sort -u)
  missing=$(comm -23 <(printf '%s\n' "$declared") <(printf '%s\n' "$union") | tr '\n' ' ')
  say 'proof'
  echo "declared: $(printf '%s' "$declared" | tr '\n' ' ')"
  echo "proved:   $(printf '%s' "$union" | tr '\n' ' ')"
  if [[ -n ${missing// /} ]]; then
    echo "PROOF INCOMPLETE — no machine proved: $missing" >&2
    exit 1
  fi
  echo 'PROOF COMPLETE — every declared corpus was proved on some machine'
}

case "${1:-}" in
  setup)  cmd_setup ;;
  gates)  shift; cmd_gates "$@" ;;
  anchor) cmd_anchor ;;
  prove)  cmd_prove ;;
  # 64 (EX_USAGE, sysexits.h) so it never collides with gates' own 0/1/2 space.
  *)      usage; exit 64 ;;
esac
